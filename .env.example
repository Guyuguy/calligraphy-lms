# 支付配置(开发期留空,系统自动走 Mock 模式)
# 设置 MOCK_PAYMENT=1 或留空 WECHAT_APPID 即启用 Mock
MOCK_PAYMENT=1

# ============================================================
# 微信支付 v3 (https://pay.weixin.qq.com)
# ============================================================
WECHAT_APPID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PEM=
WECHAT_CERT_SERIAL_NO=
WECHAT_NOTIFY_URL=http://localhost:3001/api/payments/wechat/notify

# ============================================================
# 支付宝 (https://open.alipay.com)
# ============================================================
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PEM=
ALIPAY_PUBLIC_KEY_PEM=
ALIPAY_NOTIFY_URL=http://localhost:3001/api/payments/alipay/notify

# ============================================================
# 服务端口
# ============================================================
PORT=3001
